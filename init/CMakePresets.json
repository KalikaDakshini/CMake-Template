{
	"version": 4,
	"cmakeMinimumRequired": {
		"major": 4,
		"minor": 2
	},
	"configurePresets": [
		{
			"name": "build",
			"description": "Default build preset",
			"hidden": true,
			"generator": "Unix Makefiles",
			"binaryDir": "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		},
		{
			"name": "release",
			"description": "Release build with optimizations",
			"inherits": "build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "debug",
			"description": "Debug build with sanitizers",
			"inherits": "build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		}
	],
	"buildPresets": [
		{
			"name": "base",
			"hidden": true,
			"jobs": 8
		},
		{
			"name": "build",
			"inherits": "base",
			"configurePreset": "build"
		},
		{
			"name": "release",
			"inherits": "base",
			"configurePreset": "release"
		},
		{
			"name": "debug",
			"inherits": "base",
			"configurePreset": "debug"
		}
	]
}
